{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/better-sqlite3/prebuilds/linux*.node"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__route=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
